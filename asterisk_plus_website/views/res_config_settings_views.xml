<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.asterisk_plus_website</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="5"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Asterisk Plus Website" string="Asterisk Plus Website" name="asterisk_plus_website">
          <block title="Website Talk Button" id="Website Talk Button">
            <setting>
              <div class="content-group">
                <div class="row mt8">
                  <label class="col-lg-3" for="talkbtn_sip_user" string="Sip User" />
                  <field name="talkbtn_sip_user" class="w-75" />
                </div>
                <div class="row mt8">
                  <label class="col-lg-3" for="talkbtn_sip_proxy" string="Sip Proxy" />
                  <field name="talkbtn_sip_proxy" class="w-75" />
                </div>
                <div class="row mt8">
                  <label class="col-lg-3" for="talkbtn_exten" string="Exten" />
                  <field name="talkbtn_exten" class="w-75" />
                </div>
              </div>
            </setting>
            <setting>
              <div class="content-group">
                <div class="row mt8">
                  <label class="col-lg-3" for="talkbtn_sip_secret" string="Sip Secret" />
                  <field name="talkbtn_sip_secret" class="w-75" password="True" />
                </div>
                <div class="row mt8">
                  <label class="col-lg-3" for="talkbtn_websocket" string="Websoket" />
                  <field name="talkbtn_websocket" class="w-75" />
                </div>
              </div>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
