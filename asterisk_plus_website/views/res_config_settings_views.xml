<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.asterisk_plus_website</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="5"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('settings')]" position="inside">
        <div class="app_settings_block" data-string="Asterisk Plus Website" string="Asterisk Plus Website" data-key="asterisk_plus_website">
          <h2>Website Talk Button Configs</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_right_pane">
                <div class="row">
                  <label class="o_form_label col-md-3 o_light_label" for="talkbtn_sip_user" string="Sip User"/>
                  <field name="talkbtn_sip_user"/>
                </div>
                <div class="row">
                  <label class="o_form_label col-md-3 o_light_label" for="talkbtn_sip_proxy" string="Sip Proxy"/>
                  <field name="talkbtn_sip_proxy"/>
                </div>
                <div class="row">
                  <label class="o_form_label col-md-3 o_light_label" for="talkbtn_exten" string="Exten"/>
                  <field name="talkbtn_exten"/>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_right_pane">
                <div class="row">
                  <label class="o_form_label col-md-3 o_light_label" for="talkbtn_sip_secret" string="Sip Secret"/>
                  <field name="talkbtn_sip_secret" password="True"/>
                </div>
                <div class="row">
                  <label class="o_form_label col-md-3 o_light_label" for="talkbtn_websocket" string="Websoket"/>
                  <field name="talkbtn_websocket"/>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
