<odoo>

    <record id="asterisk_plus_phone_user_form" model="ir.ui.view">
        <field name="name">asterisk_plus_phone_user_form</field>
        <field name="model">asterisk_plus.user</field>
        <field name="inherit_id" ref="asterisk_plus.asterisk_plus_user_form"/>
        <field name="arch" type="xml">
            <field name="sip_password" position="attributes">
                <attribute name="attrs">{'column_invisible':  False}</attribute>
            </field>

            <field name="sip_transport" position="attributes">
                <attribute name="attrs">{'column_invisible':  False}</attribute>
            </field>
            <field name="sip_password" position="before">
                <field name="sip_auth_user" groups="asterisk_plus.group_asterisk_admin"
                       attrs="{'column_invisible': [('parent.sip_auth_user_enabled', '=', False)]}"/>
            </field>
            <field name="call_popup_is_sticky" position="after">
                <field name="phone_ring_volume" help="Phone ring volume in %, from 0 to 100."/>
                <field name="mask_call_number" groups="asterisk_plus.group_asterisk_admin"/>
                <field name="sip_auth_user_enabled"/>
            </field>
        </field>
    </record>

</odoo>