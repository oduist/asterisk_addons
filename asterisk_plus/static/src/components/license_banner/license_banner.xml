<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="oduist.LicenseBanner" owl="1">
        <div t-if="state.visible" t-att-class="bannerClass" t-on-click="openSettings">
            <i t-if="state.type === 'info'" class="fa fa-info-circle mr-2"/>
            <i t-if="state.type === 'warning'" class="fa fa-exclamation-triangle mr-2"/>
            <i t-if="state.type === 'danger'" class="fa fa-exclamation-circle mr-2"/>
            <span t-esc="state.message"/>
        </div>
        <div t-else=""/>
    </t>

</templates>
