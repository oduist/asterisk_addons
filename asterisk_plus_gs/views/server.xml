<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="asterisk_plus_gs_server_form" model="ir.ui.view">
    <field name="name">asterisk_plus_gs_server_form</field>
    <field name="model">asterisk_plus.server</field>
    <field name="inherit_id" ref="asterisk_plus.asterisk_plus_server_form"/>
    <field name="arch" type="xml">
      <button name="get_system_information" position="after">
        <button name="gs_sync_users" type="object" icon="fa-send" string="Sync Users"/>
      </button>
      <page name="settings" position="replace">
        <page name="gs" string="Grandstream">
          <group>            
            <group>
                <field name="gs_model" required="1"/>
                <field name="gs_api_version" required="1"/>
                <field name="gs_api_url" required="1" placeholder="https://192.168.1.1:8089"/>
                <field name="gs_api_user" password="1" required="1"/>
                <field name="gs_api_password" password="1" required="1"/>
            </group>
            <group>
              <field name="generate_sip_peers" string="WebRTC Phone Users"/>
              <field name="gs_verify_ssl"/>
              <field name="gs_model_name"/>
              <field name="gs_system_time"/>
              <field name="gs_uptime"/>
            </group>
          </group>
        </page>
      </page>      
    </field>
  </record>
</odoo>