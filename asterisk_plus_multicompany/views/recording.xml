<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="asterisk_plus_recording_form_mc" model="ir.ui.view">
        <field name="name">asterisk_plus_recording_form_mc</field>
        <field name="model">asterisk_plus.recording</field>
        <field name="inherit_id" ref="asterisk_plus.asterisk_plus_recording_form"/>
        <field name="arch" type="xml">
            <field name="calling_user" position="after">
                <field name="company_id"/>
            </field>
        </field>
    </record>

    <record id="group_by_company_recording_search" model="ir.ui.view">
        <field name="name">group_by_company_recording_search</field>
        <field name="model">asterisk_plus.recording</field>
        <field name="inherit_id" ref="asterisk_plus.asterisk_plus_recording_search"/>
        <field name="arch" type="xml">
            <filter name="by_partner" position="after">
                <filter name="by_company_id" string="Company" context="{'group_by':'company_id'}"/>
            </filter>
        </field>
    </record>
  
</odoo>
